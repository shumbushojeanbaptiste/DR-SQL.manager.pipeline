# Existing DR manager metadata database; preserve its current password.
DR_METADATA_PASSWORD=use-existing-metadata-db-password
DATABASE_URL=postgres://dr_manager:${DR_METADATA_PASSWORD}@127.0.0.1:55432/dr_manager?sslmode=disable

# These three URLs connect to the existing application databases.
# For Windows PostgreSQL under WSL/Docker Desktop, replace 127.0.0.1 in the
# target URLs below with host.docker.internal for the host-networked workers.
# URL-encode special characters in each password. Keep real values only in .env.
IDENTITY_DATABASE_URL=postgres://identity_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/central_sms_identity?sslmode=disable
MESSAGING_DATABASE_URL=postgres://sms_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/central_sms?sslmode=disable
BILLING_DATABASE_URL=postgres://billing_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/central_sms_billing?sslmode=disable

# Separate, disposable PostgreSQL instance for restore verification only.
RESTORE_TEST_DB_PASSWORD=replace-with-another-long-random-value
RESTORE_TEST_DATABASE_URL=postgres://dr_restore:${RESTORE_TEST_DB_PASSWORD}@127.0.0.1:55433/postgres?sslmode=disable
POSTGRES_CLIENT_VERSION=18

# Real application database container and import targets.
REAL_DATABASE_PASSWORD=replace-with-a-local-real-database-password
REAL_DATABASE_PORT=56432
FULL_BACKUP_INTERVAL_SECONDS=300
DIFFERENTIAL_BACKUP_INTERVAL_SECONDS=120

HTTP_ADDR=127.0.0.1:8080
