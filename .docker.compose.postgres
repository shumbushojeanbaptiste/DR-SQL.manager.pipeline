
services:
  metadata-db:
    image: postgres:18
    container_name: central-sms-dr-metadata-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: dr_manager
      POSTGRES_USER: dr_manager
      POSTGRES_PASSWORD: M00dle!!
    ports:
      - "127.0.0.1:55432:5432"
    volumes:
      - dr_metadata_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U dr_manager -d dr_manager"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  dr_metadata_data:
